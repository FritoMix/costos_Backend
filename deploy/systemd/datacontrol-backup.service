[Unit]
Description=Backup horario de PostgreSQL de DATACONTROL
Documentation=file:/opt/datacontrol/docs/OPERACION.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Usuario de operación con clientes PostgreSQL, age y rclone instalados.
User=datacontrol
Group=datacontrol
EnvironmentFile=/etc/datacontrol/backup.env
WorkingDirectory=/opt/datacontrol
Environment=BACKUP_DIR=/var/lib/datacontrol-backups
Environment=RETENTION_DAYS=14
StateDirectory=datacontrol-backups
StateDirectoryMode=0750
ExecStart=/opt/datacontrol/scripts/backup_postgres.sh
NoNewPrivileges=true
PrivateTmp=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
